DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=dairy_company
DB_PORT=3306
# For Aiven: set DB_SSL=true. For verified TLS, set DB_SSL_REJECT_UNAUTHORIZED=true and provide DB_SSL_CA or DB_SSL_CA_CERT.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA can point to the Aiven CA PEM file; DB_SSL_CA_CERT can contain the PEM text itself.
PORT=3002
DAIRY_COMPANY_NAME=Your Dairy Company
TRUST_PROXY_HOPS=0
CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost:3000,http://localhost:3003
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3003,https://localhost
WORKER_TOKEN_SECRET=replace-this-with-a-long-random-secret
# Required for the office admin screens. Keep this private and use at least 12 characters.
ADMIN_USER=office
ADMIN_PASSWORD=replace-with-a-long-private-admin-password
# TextBee takes priority when configured. Keep the key only on the backend host.
# Requires an online Android phone with an active SIM linked as a TextBee device.
# TEXTBEE_API_KEY=replace-with-your-textbee-api-key
# TEXTBEE_DEVICE_ID=your-registered-textbee-device-id
# TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
# If TextBee is not configured, Africa's Talking is used instead.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=replace-with-your-Africa's-Talking-sandbox-key
