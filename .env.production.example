# Copy these names into the production backend's private environment settings.
# Do not commit a populated .env file or reuse test credentials.
NODE_ENV=production
PORT=3002

# Use a separate production database and account with only the access it needs.
DB_HOST=your-production-database-host
DB_PORT=3306
DB_NAME=your-production-database-name
DB_USER=your-production-database-user
DB_PASSWORD=replace-with-a-unique-secret
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Configure DB_SSL_CA or DB_SSL_CA_CERT when required by the database provider.

# Generate independent random values for production; never reuse test values.
WORKER_TOKEN_SECRET=replace-with-a-long-random-production-secret
WEBAUTHN_RP_ID=your-production-app-hostname
WEBAUTHN_ORIGIN=https://your-production-app-hostname

# Create a named admin account in the production Admin table using the repository's
# password-hash format. Do not rely on environment variables for admin login.

# Choose the SMS provider and use its production credentials only after approval.
SMS_ENABLED=true
SMS_DELIVERY_LOG_ENABLED=true
# TEXTBEE_API_KEY=...
# TEXTBEE_DEVICE_ID=...
# AFRICASTALKING_USERNAME=...
# AFRICASTALKING_API_KEY=...
